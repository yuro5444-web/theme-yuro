{%- comment -%}
  YURO - Klarna On-Site Messaging (widget officiel Klarna)
  Rendu sous le bouton d'achat.
  Parametres attendus :
    client_id     : Client ID Klarna (Merchant Portal > On-site messaging)
    placement_key : credit-promotion-auto-size | credit-promotion-badge | credit-promotion-small
    locale        : fr-FR
    theme         : default | dark | custom
    margin_top    : px
    uid           : identifiant unique (block.id)
{%- endcomment -%}

{%- if client_id != blank and product != blank -%}
  {%- liquid
    assign klarna_amount = product.selected_or_first_available_variant.price
    if klarna_amount == blank or klarna_amount == 0
      assign klarna_amount = product.price
    endif
  -%}

  <div class="klarna-osm" id="KlarnaOsm-{{ uid }}" style="margin-top: {{ margin_top | default: 12 }}px;">
    <klarna-placement
      data-key="{{ placement_key | default: 'credit-promotion-auto-size' }}"
      data-locale="{{ locale | default: 'fr-FR' }}"
      data-purchase-amount="{{ klarna_amount }}"
      {%- if theme != blank and theme != 'default' %} data-theme="{{ theme }}"{% endif %}
    ></klarna-placement>
  </div>

  <script type="application/json" id="KlarnaOsmPrices-{{ uid }}">
    {
      {%- for v in product.variants -%}
        "{{ v.id }}": {{ v.price }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  </script>

  {%- unless request.design_mode and false -%}
    <script async src="https://js.klarna.com/web-sdk/v1/klarna.js" data-client-id="{{ client_id }}"></script>
  {%- endunless -%}

  <script>
    (function () {
      var uid = '{{ uid }}';
      if (window.__klarnaOsmBound && window.__klarnaOsmBound[uid]) return;
      window.__klarnaOsmBound = window.__klarnaOsmBound || {};
      window.__klarnaOsmBound[uid] = true;

      var prices = {};
      try {
        var raw = document.getElementById('KlarnaOsmPrices-' + uid);
        if (raw) prices = JSON.parse(raw.textContent);
      } catch (e) {}

      function sync() {
        var wrapper = document.getElementById('KlarnaOsm-' + uid);
        if (!wrapper) return;
        var placement = wrapper.querySelector('klarna-placement');
        if (!placement) return;

        var input = document.querySelector('#product-form-{{ section.id }} input[name="id"]');
        if (!input) input = document.querySelector('form[action*="/cart/add"] input[name="id"]');
        if (!input) return;

        var price = prices[input.value];
        if (!price) return;
        if (placement.getAttribute('data-purchase-amount') === String(price)) return;

        placement.setAttribute('data-purchase-amount', String(price));
        if (window.Klarna && window.Klarna.OnsiteMessaging && window.Klarna.OnsiteMessaging.refresh) {
          window.Klarna.OnsiteMessaging.refresh();
        }
      }

      document.addEventListener('change', function () { setTimeout(sync, 350); }, true);
      document.addEventListener('variant:change', function () { setTimeout(sync, 350); }, true);
      setInterval(sync, 1200);
    })();
  </script>
{%- endif -%}
