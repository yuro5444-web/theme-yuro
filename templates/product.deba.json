        "title_highlight_2_underline-color-position": 25,
        "title_highlight_2_handwritten-color": "#6d388b",
        "title_highlight_2_handwritten-stroke-width": 3,
        "title_highlight_2_handwritten-position": 60,
        "heading_size": "h2",
        "custom_desktop_size": 39,
