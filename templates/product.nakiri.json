    "usages": {
      "type": "multicolumn",
      "blocks": {
        "u1": {
          "type": "column",
          "settings": {
            "title": "Émincer",
            "text": "<p>Lame droite, coupe verticale, contact sur toute la longueur : la rondelle se détache au lieu de rester pendue par un fil de peau. C'est la différence qu'on sent dès le premier oignon.</p>"
          }
        },
        "u2": {
          "type": "column",
          "settings": {
