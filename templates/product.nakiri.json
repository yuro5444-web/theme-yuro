    "anatomie": {
      "type": "custom-liquid",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%}\n  Les trois cartes de detail, sous le carrousel.\n\n  La vue annotee qui les precedait a ete retiree : quatre blocs de texte\n  poses sur une photo de couteau ne tenaient pas, ni en desktop ni en\n  mobile. Les cartes, elles, fonctionnent seules.\n\n  Anciennement la section anatomie, d'ou le nom des classes conserve.\n{%- endcomment -%}\n<div class=\"page-width da-anato da-anato--cartes\">\n<div class=\"da-anato__detail\">\n    <p class=\"da-anato__surtitre\">Découvrez chaque détail</p>\n    <ul class=\"da-anato__cartes\">\n      <li class=\"da-anato__carte\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/hf_20260820_112414_bed53110-7e58-46da-ab91-b0cc028c1354.png?v=1787225200&width=900\" width=\"900\" height=\"675\" loading=\"lazy\" decoding=\"async\" alt=\"Macro du fil de la lame, les couches de damas courent jusqu'au tranchant\">\n        <span class=\"da-anato__legende\"><b class=\"da-anato__carte-nom\">Le tranchant</b><em class=\"da-anato__carte-dit\">Quinze degrés par face. La lame entre dans l'aliment au lieu de l'écraser.</em></span>\n      </li>\n      <li class=\"da-anato__carte\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-hero-damas.png?v=1786956870&width=900\" width=\"900\" height=\"675\" loading=\"lazy\" decoding=\"async\" alt=\"Macro du motif damas revele a l'acide\">\n        <span class=\"da-anato__legende\"><b class=\"da-anato__carte-nom\">L'acier</b><em class=\"da-anato__carte-dit\">Un cœur VG-10 trempé à 61 HRC, protégé par soixante-sept couches.</em></span>\n      </li>\n      <li class=\"da-anato__carte\">\n        <img src=\"{{ 'yuro-detail-manche.jpg' | asset_url }}\" width=\"1200\" height=\"896\" loading=\"lazy\" decoding=\"async\" alt=\"Le manche entier : bague de laiton, bois stabilise brun rouge et culot de laiton\">\n        <span class=\"da-anato__legende\"><b class=\"da-anato__carte-nom\">Le manche</b><em class=\"da-anato__carte-dit\">Bois stabilisé, mitre et culot en laiton massif.</em></span>\n      </li>\n    </ul>\n  </div>\n</div>",
        "color_scheme": "background-2",
        "padding_top": 72,
        "padding_bottom": 72
      }
    },
    "galerie": {
      "type": "custom-liquid",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<div class=\"page-width da-galerie\">\n  <div class=\"da-galerie__entete\">\n    <h2 class=\"da-galerie__titre\">En voir plus</h2>\n    <div class=\"da-galerie__fleches\">\n      <button type=\"button\" class=\"da-galerie__fleche\" data-da-galerie=\"prev\" aria-label=\"Photo précédente\">\n        <svg viewBox=\"0 0 12 20\" fill=\"none\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M10 1 2 10l8 9\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg>\n      </button>\n      <button type=\"button\" class=\"da-galerie__fleche\" data-da-galerie=\"next\" aria-label=\"Photo suivante\">\n        <svg viewBox=\"0 0 12 20\" fill=\"none\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2 1l8 9-8 9\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg>\n      </button>\n    </div>\n  </div>\n  <div class=\"da-galerie__piste\" tabindex=\"0\" role=\"region\" aria-label=\"Le Nakiri 165 en cuisine\">\n    <figure class=\"da-galerie__vue\">\n      <img src=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-08.jpg?v=1788188571&width=700\"\n           srcset=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-08.jpg?v=1788188571&width=400 400w, https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-08.jpg?v=1788188571&width=700 700w, https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-08.jpg?v=1788188571&width=1000 1000w\"\n           sizes=\"(min-width: 990px) 32rem, 70vw\"\n           width=\"1080\" height=\"1350\" loading=\"lazy\" decoding=\"async\"\n           alt=\"Le Nakiri 165 posé sur la planche à côté d'un concombre détaillé en rondelles, vu de dessus.\">\n    </figure>\n    <figure class=\"da-galerie__vue\">\n      <img src=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-05.jpg?v=1788188102&width=700\"\n           srcset=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-05.jpg?v=1788188102&width=400 400w, https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-05.jpg?v=1788188102&width=700 700w, https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-05.jpg?v=1788188102&width=1000 1000w\"\n           sizes=\"(min-width: 990px) 32rem, 70vw\"\n           width=\"1080\" height=\"1350\" loading=\"lazy\" decoding=\"async\"\n           alt=\"Le Nakiri 165 posé à plat sur une planche, à côté d'un concombre en rondelles.\">\n    </figure>\n    <figure class=\"da-galerie__vue\">\n      <img src=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-03.jpg?v=1788187480&width=700\"\n           srcset=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-03.jpg?v=1788187480&width=400 400w, https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-03.jpg?v=1788187480&width=700 700w, https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-03.jpg?v=1788187480&width=1000 1000w\"\n           sizes=\"(min-width: 990px) 32rem, 70vw\"\n           width=\"1080\" height=\"1350\" loading=\"lazy\" decoding=\"async\"\n           alt=\"Le Nakiri 165 sorti de son carton sur une table de cuisine.\">\n    </figure>\n    <figure class=\"da-galerie__vue\">\n      <img src=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-04.jpg?v=1788187480&width=700\"\n           srcset=\"https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-04.jpg?v=1788187480&width=400 400w, https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-04.jpg?v=1788187480&width=700 700w, https://cdn.shopify.com/s/files/1/1052/4734/2934/files/yuro-gal-naki-04.jpg?v=1788187480&width=1000 1000w\"\n           sizes=\"(min-width: 990px) 32rem, 70vw\"\n           width=\"1080\" height=\"1350\" loading=\"lazy\" decoding=\"async\"\n           alt=\"Le Nakiri 165 rangé dans un tiroir avec les couteaux du quotidien.\">\n    </figure>\n  </div>\n</div>\n\n<script>\n  (function () {\n    var bloc = document.currentScript.previousElementSibling;\n    while (bloc && !bloc.classList.contains('da-galerie')) bloc = bloc.previousElementSibling;\n    if (!bloc) return;\n    var piste = bloc.querySelector('.da-galerie__piste');\n    var vue = piste && piste.querySelector('.da-galerie__vue');\n    if (!piste || !vue) return;\n    bloc.querySelectorAll('[data-da-galerie]').forEach(function (bouton) {\n      bouton.addEventListener('click', function () {\n        var pas = vue.getBoundingClientRect().width + 16;\n        piste.scrollBy({ left: bouton.dataset.daGalerie === 'next' ? pas : -pas, behavior: 'smooth' });\n      });\n    });\n  })();\n</script>",
