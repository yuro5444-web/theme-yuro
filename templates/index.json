    "guide": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Guide d'achat : trois questions, une recommandation.\n\n  La logique reprend les positions des FAQ produit : le Gyuto est le\n  point de depart, le Nakiri complete un couteau de chef, le Deba et\n  le Honesuki sont des couteaux de specialite. Les fiches (image,\n  type, nom, prix) sont lues en direct sur les produits.\n\n  Sans JavaScript, le bloc affiche une liste simple des lames.\n{%- endcomment -%}\n\n{%- assign fiches = 'gyuto:gyuto-200-damas-67-couches,nakiri:nakiri-165-damas-67-couches,deba:deba-165-damas-67-couches,honesuki:honesuki-150-damas-67-couches,duo:coffret-duo-gyuto-nakiri-damas,collection:coffret-collection-quatre-couteaux-damas' | split: ',' -%}\n\n<div class=\"page-width da-guide\" data-da-guide>\n  <p class=\"da-guide__eyebrow\">Guide d'achat</p>\n  <h2 class=\"da-guide__titre\">Quel couteau pour vous ?</h2>\n  <p class=\"da-guide__intro\">Trois questions. La bonne lame dépend de ce que vous coupez, pas du reste.</p>\n\n  <ol class=\"da-guide__etapes\" role=\"list\">\n\n    <li class=\"da-guide__etape\" data-etape=\"1\">\n      <p class=\"da-guide__num\">01 / 03</p>\n      <h3 class=\"da-guide__question\">Que coupez-vous le plus souvent ?</h3>\n      <div class=\"da-guide__reponses\" role=\"group\" aria-label=\"Ce que vous coupez le plus souvent\">\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"cuisine\" data-valeur=\"legumes\" aria-pressed=\"false\">Des légumes, avant tout</button>\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"cuisine\" data-valeur=\"tout\" aria-pressed=\"false\">Un peu de tout</button>\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"cuisine\" data-valeur=\"poisson\" aria-pressed=\"false\">Du poisson entier</button>\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"cuisine\" data-valeur=\"volaille\" aria-pressed=\"false\">De la volaille entière</button>\n      </div>\n    </li>\n\n    <li class=\"da-guide__etape\" data-etape=\"2\" hidden>\n      <p class=\"da-guide__num\">02 / 03</p>\n      <h3 class=\"da-guide__question\">Qu'avez-vous déjà sur la planche ?</h3>\n      <div class=\"da-guide__reponses\" role=\"group\" aria-label=\"Ce que vous avez déjà\">\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"actuel\" data-valeur=\"rien\" aria-pressed=\"false\">Rien qui coupe vraiment</button>\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"actuel\" data-valeur=\"chef\" aria-pressed=\"false\">Un couteau de chef européen</button>\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"actuel\" data-valeur=\"japonais\" aria-pressed=\"false\">Déjà une lame japonaise</button>\n      </div>\n    </li>\n\n    <li class=\"da-guide__etape\" data-etape=\"3\" hidden>\n      <p class=\"da-guide__num\">03 / 03</p>\n      <h3 class=\"da-guide__question\">Combien de lames ?</h3>\n      <div class=\"da-guide__reponses\" role=\"group\" aria-label=\"Combien de lames\">\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"cherche\" data-valeur=\"un\" aria-pressed=\"false\">Une seule, la bonne</button>\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"cherche\" data-valeur=\"duo\" aria-pressed=\"false\">Le duo du quotidien</button>\n        <button type=\"button\" class=\"da-guide__reponse\" data-cle=\"cherche\" data-valeur=\"collection\" aria-pressed=\"false\">La collection complète</button>\n      </div>\n    </li>\n\n  </ol>\n\n  <div class=\"da-guide__resultat\" hidden aria-live=\"polite\">\n    <p class=\"da-guide__recap\" data-recap></p>\n    <p class=\"da-guide__eyebrow\">Notre recommandation</p>\n\n    {%- for paire in fiches -%}\n      {%- assign parts = paire | split: ':' -%}\n      {%- assign cle = parts[0] -%}\n      {%- assign produit = all_products[parts[1]] -%}\n      {%- if produit != blank -%}\n        <article class=\"da-guide__fiche\" data-fiche=\"{{ cle }}\" hidden>\n          <a class=\"da-guide__lien\" href=\"{{ produit.url }}\">\n            {%- if produit.featured_image -%}\n              <span class=\"da-guide__visuel\">\n                {{\n                  produit.featured_image\n                  | image_url: width: 720\n                  | image_tag:\n                    loading: 'lazy',\n                    widths: '360, 540, 720',\n                    sizes: '(min-width: 750px) 26rem, 60vw',\n                    alt: produit.title\n                }}\n              </span>\n            {%- endif -%}\n            <span class=\"da-guide__texte\">\n              {%- if produit.type != blank -%}\n                <span class=\"da-guide__type\">{{ produit.type }}</span>\n              {%- endif -%}\n              <span class=\"da-guide__nom\">{{ produit.title }}</span>\n              <span class=\"da-guide__prix\">\n                {{ produit.price | money }}\n                {%- if produit.compare_at_price > produit.price -%}\n                  <s class=\"da-guide__ancien\">{{ produit.compare_at_price | money }}</s>\n                {%- endif -%}\n              </span>\n              <span class=\"da-guide__pourquoi\" data-pourquoi></span>\n              <span class=\"da-guide__cta\">\n                {%- if produit.type == 'Coffret de couteaux' -%}Voir le coffret{%- else -%}Voir la lame{%- endif -%}\n              </span>\n            </span>\n          </a>\n        </article>\n      {%- endif -%}\n    {%- endfor -%}\n\n    <button type=\"button\" class=\"da-guide__reset\" data-reset>Recommencer</button>\n  </div>\n\n  <ul class=\"da-guide__sansjs\" role=\"list\">\n    {%- for paire in fiches limit: 4 -%}\n      {%- assign parts = paire | split: ':' -%}\n      {%- assign produit = all_products[parts[1]] -%}\n      {%- if produit != blank -%}\n        <li><a href=\"{{ produit.url }}\">{{ produit.title }}</a> : {{ produit.type | downcase }}</li>\n      {%- endif -%}\n    {%- endfor -%}\n  </ul>\n</div>\n\n<script>\n(function () {\n  var racine = document.querySelector('[data-da-guide]');\n  if (!racine) return;\n  racine.classList.add('da-guide--js');\n\n  var etapes = Array.prototype.slice.call(racine.querySelectorAll('.da-guide__etape'));\n  var resultat = racine.querySelector('.da-guide__resultat');\n  var recap = racine.querySelector('[data-recap]');\n  var etat = {};\n  var libelles = {};\n\n  var POURQUOI = {\n    'gyuto': \"Le couteau qui sort en premier, tous les jours. Il tranche le légume, pare la viande, lève un filet : c'est le point de départ d'une cuisine, et souvent le seul couteau qu'on utilise vraiment.\",\n    'gyuto|rien': \"Vous n'avez rien qui coupe vraiment : commencez par la lame qui fait tout, légumes compris. Le Nakiri viendra ensuite, quand le Gyuto aura pris sa place.\",\n    'nakiri': \"Vous avez déjà de quoi trancher le reste. Le Nakiri prend le légume en charge et le fait mieux qu'un couteau de chef : fil droit, coupe nette jusqu'à la planche, sans rien écraser.\",\n    'nakiri|japonais': \"Vous avez déjà la lame polyvalente. La suivante est celle qui fait une seule chose, mieux : le Nakiri, pour tout ce qui passe par la planche à légumes.\",\n    'deba': \"Le poisson entier demande une lame qui passe l'arête sans broncher et lève un filet d'un seul geste. Le Deba ne fait que ça, et rien d'autre ne le fait aussi bien.\",\n    'deba|rien': \"Le poisson entier demande une lame qui passe l'arête sans broncher. Le Deba fait exactement ça. Pour le reste de la cuisine, il ne remplacera pas un Gyuto : pensez-y pour la suite.\",\n    'honesuki': \"Désosser une volaille, c'est chercher le joint plutôt que la force. La pointe rigide du Honesuki entre dans l'articulation et longe l'os sans déchirer la chair.\",\n    'honesuki|rien': \"Désosser une volaille, c'est chercher le joint plutôt que la force : c'est le travail du Honesuki. Pour le reste de la cuisine, il ne remplacera pas un Gyuto : pensez-y pour la suite.\",\n    'duo': \"Le Gyuto pour tout, le Nakiri pour le légume : les deux gestes de base qu'une seule lame ne réunit pas. C'est le départ le plus logique.\",\n    'duo|special': \"Le Gyuto pour tout, le Nakiri pour le légume : la base d'une cuisine. Le Deba ou le Honesuki s'y ajouteront quand le besoin sera là.\",\n    'collection': \"Quatre lames, quatre gestes qui ne se remplacent pas. Utile si le poisson entier et la volaille entière passent régulièrement sur votre planche ; sinon, le duo suffit.\"\n  };\n\n  function choisir(e) {\n    if (e.cherche === 'collection') return 'collection';\n    if (e.cherche === 'duo') return 'duo';\n    if (e.cuisine === 'poisson') return 'deba';\n    if (e.cuisine === 'volaille') return 'honesuki';\n    if (e.cuisine === 'legumes') return e.actuel === 'rien' ? 'gyuto' : 'nakiri';\n    return e.actuel === 'japonais' ? 'nakiri' : 'gyuto';\n  }\n\n  function pourquoi(produit, e) {\n    if (produit === 'duo' && (e.cuisine === 'poisson' || e.cuisine === 'volaille')) return POURQUOI['duo|special'];\n    return POURQUOI[produit + '|' + e.actuel] || POURQUOI[produit];\n  }\n\n  function montrerEtape(n) {\n    etapes.forEach(function (li) { li.hidden = li.getAttribute('data-etape') !== String(n); });\n  }\n\n  function conclure() {\n    var produit = choisir(etat);\n    var fiches = racine.querySelectorAll('.da-guide__fiche');\n    Array.prototype.forEach.call(fiches, function (f) {\n      var ok = f.getAttribute('data-fiche') === produit;\n      f.hidden = !ok;\n      if (ok) f.querySelector('[data-pourquoi]').textContent = pourquoi(produit, etat);\n    });\n    recap.textContent = [libelles.cuisine, libelles.actuel, libelles.cherche].join('  ·  ');\n    etapes.forEach(function (li) { li.hidden = true; });\n    resultat.hidden = false;\n    resultat.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n  }\n\n  racine.addEventListener('click', function (ev) {\n    var b = ev.target.closest('.da-guide__reponse');\n    if (b) {\n      var cle = b.getAttribute('data-cle');\n      etat[cle] = b.getAttribute('data-valeur');\n      libelles[cle] = b.textContent.trim();\n      Array.prototype.forEach.call(b.parentNode.querySelectorAll('.da-guide__reponse'), function (x) {\n        x.setAttribute('aria-pressed', x === b ? 'true' : 'false');\n      });\n      var suivante = Number(b.closest('.da-guide__etape').getAttribute('data-etape')) + 1;\n      if (suivante > etapes.length) { conclure(); } else { montrerEtape(suivante); }\n      return;\n    }\n    if (ev.target.closest('[data-reset]')) {\n      etat = {}; libelles = {};\n      Array.prototype.forEach.call(racine.querySelectorAll('.da-guide__reponse'), function (x) { x.setAttribute('aria-pressed', 'false'); });\n      resultat.hidden = true;\n      montrerEtape(1);\n      racine.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n  });\n})();\n</script>\n",
        "color_scheme": "background-1",
        "padding_top": 72,
        "padding_bottom": 72
      }
    }
  },
  "order": [
    "hero",
    "recit",
    "piliers",
    "lames",
    "guide",
    "pourquoi",
    "anatomie",
    "forge",
    "faq",
    "lettre"
  ]
}
